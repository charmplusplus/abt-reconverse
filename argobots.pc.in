prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: argobots
Description: Argobots API implemented on top of Reconverse (abt-reconverse)
Version: @ABT_PC_VERSION@
URL: http://www.argobots.org/
Requires:
Libs: -L${libdir} -labt
Libs.private: @ABT_LIBS_PRIVATE@
Cflags: -I${includedir}
